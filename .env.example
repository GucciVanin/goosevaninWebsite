# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# For `dotnet run` development, store the same values with `dotnet user-secrets` instead
# (see README.md, "Configuration and secrets").

SITE_DOMAIN=localhost

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gustavo Couto Vanin

# MailerSend HTTP API key (sends the templated contact emails). Optional override of the sender:
# MAILERSEND_FROM_EMAIL=
MAILERSEND_API_KEY=

# Inbox that receives verified contact messages.
CONTACT_RECIPIENT_EMAIL=
