# Test-only values for the container verification run (scripts/verify.ps1 copies this to .env.verify if
# it is missing). The verification stack's data is reset on every run, so none of these protect anything.
# Do NOT reuse any real password here.

# Administrator the runtime tests sign in with (created by the run through `admin provision`).
VERIFY_ADMIN_EMAIL=verify-admin@example.test
VERIFY_ADMIN_PASSWORD=Verify-admin-test-pass-1

# Second administrator, used to test `admin reset-password`.
VERIFY_ADMIN2_EMAIL=verify-admin2@example.test
VERIFY_ADMIN2_PASSWORD=Verify-admin2-first-pass-1
VERIFY_ADMIN2_NEW_PASSWORD=Verify-admin2-second-pass-2
